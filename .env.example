# Set these in Render's Environment page. Python does not load this file.
DISCORD_TOKEN=replace-in-render
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require
FAILOVER_ENABLED=true
BOT_GROUP=sunset
# Use render-b on the second service. Keep each ID stable across deployments.
BOT_INSTANCE_ID=render-a
PORT=8080

# On your independent pinger/watchdog host only:
# BOT_SERVICES={"render-a":"https://PRIMARY.onrender.com","render-b":"https://BACKUP.onrender.com"}
# WATCHDOG_DATABASE_URL=postgresql://WATCHDOG-USER:PASSWORD@HOST:5432/postgres?sslmode=require
# HEALTHCHECKS_URL=https://hc-ping.com/YOUR-CHECK-ID
# ALERT_WEBHOOK_URL=https://your-notification-provider.example/webhook
